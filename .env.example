# Application
APP_ENV=development
APP_NAME=Warehouse AI
API_V1_PREFIX=/api/v1
APP_TIMEZONE=Asia/Bangkok

# PostgreSQL
POSTGRES_DB=warehouse_ai
POSTGRES_USER=warehouse_app
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://warehouse_app:change_me_local_only@postgres:5432/warehouse_ai

# Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional AI provider (leave empty when unused)
AI_PROVIDER=
AI_API_KEY=
